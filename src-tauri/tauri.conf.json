{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DaevaLens",
  "version": "0.1.0",
  "identifier": "io.github.daevalens",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://assets.playnccdn.com; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../upstream/src/data/": "data/"
    },
    "category": "Utility",
    "shortDescription": "Multi-overlay combat meter for AION 2",
    "linux": {
      "deb": {
        "depends": [
          "libpcap0.8",
          "libcap2-bin"
        ],
        "postInstallScript": "../packaging/linux/postinst.sh"
      },
      "rpm": {
        "depends": [
          "libpcap",
          "libcap"
        ],
        "postInstallScript": "../packaging/linux/postinst.sh"
      }
    },
    "publisher": "DaevaLens contributors",
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/Yeetlex/DaevaLens",
    "longDescription": "Overlays, fights and analysis for AION 2 built on the protocol parser of A2Tools DPS Meter. Reads only the network traffic the game receives.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}